# バックおんバックス: ランキングを保存する PostgreSQL の設定
#
# 使うのは .env という名前のファイルです(本番起動.bat が、無ければこのファイルから作ります)。
# .env にはパスワードが入るので、GitHub には上がりません(.gitignore で除外しています)。
# 書いたら本番起動.bat をダブルクリックすると、つながったか表示されます。
# 本番サーバーが動いている間に書きかえても、2 秒ほどで新しい設定でつなぎ直します。

# PostgreSQL が動いているパソコンの IP アドレス(ゲームのサーバーと同じパソコンなら localhost)
PGHOST=
PGPORT=5432
# データベース名・ユーザー名
PGDATABASE=
PGUSER=
# パスワード(# や記号が入っていても、そのまま書いてかまいません。前後に空白があるときだけ "..." でかこむ)
PGPASSWORD=

# サーバーが SSL を必要とするときだけ、次の行の先頭の # を消す
# PGSSLMODE=require
